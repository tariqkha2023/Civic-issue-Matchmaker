# Teammate local setup: run commands from backend/; no Docker or API keys needed.
DATABASE_URL=sqlite:///./civic-dev.db
# Optional PostgreSQL: postgresql://civic_user:civic_password@localhost:5432/civic_matchmaker
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Optional permitted repository credentials. Never commit actual tokens.
# GITHUB_TOKEN=
# GITLAB_TOKEN=

# Keep the bundled public issues and AI cache offline on first run.
# Set true only when deliberately refreshing public sources. No OAuth/write-back.
ENABLE_WORKER=false
APP_DEMO=false
# Recommended for complete indexing of large trackers within GitHub quotas:
# GITHUB_TOKEN=your_public_repository_read_token
# Daily SQLite backups, retained for seven days (contains private account data):
BACKUP_DIR=./backups

# Optional public-issue metadata enrichment; never commit a real key.
# OPENROUTER_API_KEY=
