# Recommended: start the database with docker compose up -d from the repo root.
DATABASE_URL=postgresql://civic_user:civic_password@localhost:5432/civic_matchmaker
# For a local demo without Docker, replace with sqlite:///./civic-dev.db
APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Optional permitted repository credentials. Never commit actual tokens.
# GITHUB_TOKEN=
# GITLAB_TOKEN=

# Read-only GitHub source worker (enabled by default). No OAuth/write-back.
ENABLE_WORKER=true
APP_DEMO=false
# Recommended for complete indexing of large trackers within GitHub quotas:
# GITHUB_TOKEN=your_public_repository_read_token
# Daily SQLite backups, retained for seven days (contains private account data):
BACKUP_DIR=./backups

# Optional public-issue metadata enrichment; never commit a real key.
# OPENROUTER_API_KEY=
